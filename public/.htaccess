<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Routing: Send all /api/* requests to local Node.js port 3000
  RewriteCond %{REQUEST_URI} ^/api/(.*)$
  RewriteRule ^api/(.*)$ /api/index.php [QSA,L]

  # 2. React Router Fallback: Any other non-existent file/dir gets routed to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
