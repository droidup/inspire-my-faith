<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Send all /api/* requests to the local PHP proxy (since Hostinger blocks direct Port proxying)
  RewriteCond %{REQUEST_URI} ^/api/(.*)$
  RewriteRule ^api/(.*)$ /api/index.php [QSA,L]

  # React Router Fallback: Any other non-existent file/dir gets routed to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
